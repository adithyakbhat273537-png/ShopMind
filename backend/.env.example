# Supabase Dashboard → Project Settings → Database → Connection string (URI)
# Use the direct connection or Supavisor session mode. Keep this backend-only.
SUPABASE_DB_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
FRONTEND_ORIGINS=http://localhost:5173
PORT=5000
FLASK_DEBUG=false
# Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Optional invoice branding. Leave blank until the store's real contact details are known.
SHOPMIND_STORE_NAME=ShopMind Hardware Store
SHOPMIND_STORE_PHONE=
SHOPMIND_STORE_EMAIL=
SHOPMIND_STORE_ADDRESS=
SHOPMIND_GSTIN=
# GST percent. Defaults to 0 when not configured.
SHOPMIND_GST_RATE=18
# Ollama's native API. Use localhost for an Ollama install on this PC.
# For Colab, use the HTTPS URL of your secured Ollama-compatible tunnel/gateway.
# Keep this backend-only; never add it to frontend/.env.local or a VITE_* variable.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Optional Bearer header for a gateway that enforces this token.
OLLAMA_API_KEY=
